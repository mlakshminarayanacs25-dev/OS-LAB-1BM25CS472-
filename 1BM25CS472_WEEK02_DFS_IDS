        "\n",
        "# 8-Puzzle Problem using IDS\n",
        "\n",
        "initial = (1, 2, 3,\n",
        "           4, 0, 6,\n",
        "           7, 5, 8)\n",
        "\n",
        "goal = (1, 2, 3,\n",
        "        4, 5, 6,\n",
        "        7, 8, 0)\n",
        "\n",
        "\n",
        "def get_neighbors(state):\n",
        "    zero = state.index(0)\n",
        "    row = zero // 3\n",
        "    col = zero % 3\n",
        "\n",
        "    # Movement order: Down, Right, Up, Left\n",
        "    moves = [\n",
        "        (1, 0, \"Down\"),\n",
        "        (0, 1, \"Right\"),\n",
        "        (-1, 0, \"Up\"),\n",
        "        (0, -1, \"Left\")\n",
        "    ]\n",
        "\n",
        "    neighbors = []\n",
        "\n",
        "    for dr, dc, action in moves:\n",
        "        nr = row + dr\n",
        "        nc = col + dc\n",
        "\n",
        "        if 0 <= nr < 3 and 0 <= nc < 3:\n",
        "            new_zero = nr * 3 + nc\n",
        "            new_state = list(state)\n",
        "\n",
        "            new_state[zero], new_state[new_zero] = (\n",
        "                new_state[new_zero], new_state[zero]\n",
        "            )\n",
        "\n",
        "            neighbors.append((tuple(new_state), action))\n",
        "\n",
        "    return neighbors\n",
        "\n",
        "\n",
        "def depth_limited_dfs(state, limit, path, actions):\n",
        "    print(\"Checking:\", state, \"Depth:\", len(actions))\n",
        "\n",
        "    if state == goal:\n",
        "        return path, actions\n",
        "\n",
        "    if limit == 0:\n",
        "        return None\n",
        "\n",
        "    for next_state, action in get_neighbors(state):\n",
        "        if next_state not in path:\n",
        "            result = depth_limited_dfs(\n",
        "                next_state,\n",
        "                limit - 1,\n",
        "                path + [next_state],\n",
        "                actions + [action]\n",
        "            )\n",
        "\n",
        "            if result is not None:\n",
        "                return result\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def ids():\n",
        "    depth = 0\n",
        "\n",
        "    while True:\n",
        "        print(\"\\nDepth limit:\", depth)\n",
        "\n",
        "        result = depth_limited_dfs(\n",
        "            initial, depth, [initial], []\n",
        "        )\n",
        "\n",
        "        if result is not None:\n",
        "            return result\n",
        "\n",
        "        depth += 1\n",
        "\n",
        "\n",
        "path, actions = ids()\n",
        "\n",
        "print(\"\\nGoal found!\")\n",
        "print(\"Solution moves:\", actions)\n",
        "print(\"Total moves:\", len(actions))\n",
        "\n",
        "for state in path:\n",
        "    print(state[:3])\n",
        "    print(state[3:6])\n",
        "    print(state[6:])\n",
        "    print()\n"
